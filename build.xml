<project name="Brewday" default="dist" basedir=".">

    <description>Brewday</description>

    <!-- load these properties, to get at the version -->
    <property file="src/dist/dist.brewday.cfg"/>
    <!-- All Ant outputs and optional tooling trees live under ./build (see clean target). -->
    <property name="build_base" location="./build"/>
    <!-- Packaging JDK resolution (first match wins): JDK_PACKAGE_HOME; packaging-jdk.local.xml; JAVA_HOME; build/.packaging-jdk/current; java.home (Ant/JVM). Distro OpenJDK may patch java.security — jlink fails; use Temurin etc. See doc/packaging.md. -->
    <property environment="env"/>
    <condition property="jdk.package.home" value="${env.JDK_PACKAGE_HOME}">
        <isset property="env.JDK_PACKAGE_HOME"/>
    </condition>
    <!-- Gitignored local override — overrides JAVA_HOME so Fedora users can keep distro JAVA_HOME for the IDE and point packaging at Temurin. Copy packaging-jdk.local.xml.example to packaging-jdk.local.xml. -->
    <import file="packaging-jdk.local.xml" optional="true"/>
    <condition property="jdk.package.home" value="${env.JAVA_HOME}">
        <and>
            <isset property="env.JAVA_HOME"/>
            <not>
                <isset property="jdk.package.home"/>
            </not>
        </and>
    </condition>
    <!-- Optional unpacked Temurin (or similar) JDK; same layout as old repo-root .packaging-jdk but under ./build so ant clean removes it -->
    <condition property="jdk.package.home" value="${build_base}/.packaging-jdk/current">
        <and>
            <available file="${build_base}/.packaging-jdk/current/bin/jdeps" type="file"/>
            <not>
                <isset property="jdk.package.home"/>
            </not>
        </and>
    </condition>
    <condition property="jdk.package.home" value="${java.home}">
        <not>
            <isset property="jdk.package.home"/>
        </not>
    </condition>

    <!-- launch4j -->
<!--    <property name="launch4j.dir" location="e:/utils/launch4j"/>-->
<!--
    <taskdef name="launch4j"
             classname="net.sf.launch4j.ant.Launch4jTask"
             classpath="${launch4j.dir}/launch4j.jar
	        :${launch4j.dir}/lib/xstream.jar"/>
-->

    <!-- set global properties for this build -->
    <property name="src" location="src/main/java"/>
    <property name="src.test" location="src/test/java"/>
    <property name="build" location="${build_base}/classes"/>
    <property name="build.test" location="${build_base}/test-classes"/>
    <property name="java.release" value="21"/>
    <property name="dist" location="${build_base}/dist"/>
    <!-- zipdist / package staging output -->
    <property name="zipdist"
              location="${dist}/brewday_${mclachlan.brewday.version}/brewday_${mclachlan.brewday.version}"/>
    <property name="srcdist"
              location="${dist}/brewday_${mclachlan.brewday.version}_src/brewday_${mclachlan.brewday.version}_src"/>

    <!-- jlink/jpackage intermediates + staged Swing tree: all under build/dist/package/ -->
    <property name="package.base" location="${dist}/package"/>
    <property name="package.stage" location="${package.base}/stage"/>
    <!-- CreateProdDb scratch tree (copy of data/db → seeded JSON); under ./build so ant clean removes it -->
    <property name="package.prod.db.work" location="${package.base}/prod-db-work"/>
    <!-- jpackage Linux app-image: PNG required for icon (see package-linux-app-image) -->
    <property name="package.icon.linux" location="${basedir}/data/img/brewday.png"/>
    <property name="package.license.file" location="${basedir}/LICENSE.TXT"/>

    <!-- Append only modules jdeps tends to omit (comma prefix added when non-empty).
         Avoid duplicating modules already emitted by jdeps print-module-deps. -->
    <property name="package.jlink.manual.modules" value="jdk.localedata"/>

    <!-- os-specific jlink+jpackage artifacts -->
    <condition property="package.os.family" value="windows" else="linux">
        <os family="windows"/>
    </condition>
    <property name="package.runtime.image"
              location="${package.base}${file.separator}runtime-${package.os.family}"/>
    <property name="jdk.modules.dir" location="${jdk.package.home}/jmods"/>
    <property name="package.jpackage.out.linux" location="${package.base}${file.separator}out${file.separator}linux"/>
    <property name="package.jpackage.out.windows" location="${package.base}${file.separator}out${file.separator}windows"/>

    <!-- jdeps / jlink / jpackage executables -->
    <condition property="_jdk.cmd.suffix" value=".exe" else="">
        <os family="windows"/>
    </condition>
    <property name="jdk.jdeps.cmd" location="${jdk.package.home}${file.separator}bin${file.separator}jdeps${_jdk.cmd.suffix}"/>
    <property name="jdk.jlink.cmd" location="${jdk.package.home}${file.separator}bin${file.separator}jlink${_jdk.cmd.suffix}"/>
    <property name="jdk.jpackage.cmd" location="${jdk.package.home}${file.separator}bin${file.separator}jpackage${_jdk.cmd.suffix}"/>

    <path id="project.class.path">
        <pathelement location="${build}"/>
        <pathelement location="lib/freemarker/freemarker.jar"/>
        <pathelement location="lib/gson/gson-2.8.6.jar"/>
        <pathelement location="lib/jgrapht/jgrapht-core-1.5.0.jar"/>
        <pathelement location="lib/jgrapht/jheaps-0.13.jar"/>
        <pathelement location="lib/commons-csv/commons-csv-1.8.jar"/>
        <pathelement location="lib/commons-math/commons-math3-3.6.1.jar"/>
        <pathelement location="lib/flatlaf/flatlaf-3.5.4.jar"/>
        <pathelement location="lib/jdatepicker/jdatepicker-2.0.1.jar"/>
    </path>

    <path id="test.class.path">
        <pathelement location="${build}"/>
        <pathelement location="${build.test}"/>
        <pathelement location="lib/test/junit-4.13.2.jar"/>
        <pathelement location="lib/test/hamcrest-core-1.3.jar"/>
        <path refid="project.class.path"/>
    </path>

    <!--======================================================================-->
    <target name="clean">
        <delete dir="${build_base}"/>
    </target>

    <!-- Wipe only bytecode trees; keep ./build/dist (packaging outputs) so e.g.
         "ant package-linux-app-image zipdist" does not erase the app-image when zipdist pulls compile again -->
    <!--======================================================================-->
    <target name="clean-compile-output">
        <delete dir="${build}" quiet="true"/>
        <delete dir="${build.test}" quiet="true"/>
    </target>

    <!--======================================================================-->
    <target name="init" depends="clean-compile-output">
        <tstamp/>
        <mkdir dir="${build}"/>
        <mkdir dir="${build.test}"/>
    </target>

    <!--======================================================================-->
    <target name="compile" depends="init">
        <javac includeantruntime="false"
               srcdir="${src}" destdir="${build}"
               classpathref="project.class.path"
               release="${java.release}"
               debug="true" encoding="UTF-8"/>
    </target>

    <!--======================================================================-->
    <target name="compile-tests" depends="compile">
        <javac includeantruntime="false"
               srcdir="${src.test}" destdir="${build.test}"
               classpathref="test.class.path"
               release="${java.release}"
               debug="true" encoding="UTF-8"/>
    </target>

    <!-- Swing/EWT tests require a display; on headless Linux CI run e.g. xvfb-run -a ant test (doc/bug-backlog.md). -->
    <!--======================================================================-->
