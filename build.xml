            <arg value="mclachlan.brewday.ui.swing.screens.AboutScreenTest"/>
            <arg value="mclachlan.brewday.ui.swing.dialogs.EditWaterDialogTest"/>
            <arg value="mclachlan.brewday.ui.swing.dialogs.EditWaterParametersDialogTest"/>
            <arg value="mclachlan.brewday.ui.swing.dialogs.EditFermentableDialogTest"/>
            <arg value="mclachlan.brewday.ui.swing.widgets.SwingQuantityEditWidgetTest"/>
            <arg value="mclachlan.brewday.ui.swing.widgets.SwingQuantitySelectAndEditWidgetTest"/>
            <arg value="mclachlan.brewday.ui.swing.screens.InventoryScreenTest"/>
            <arg value="mclachlan.brewday.ui.swing.screens.WaterScreenTest"/>
            <arg value="mclachlan.brewday.ui.swing.screens.WaterParametersScreenTest"/>
            <arg value="mclachlan.brewday.ui.swing.screens.FermentablesScreenTest"/>
            <arg value="mclachlan.brewday.ui.swing.screens.EquipmentProfilesScreenTest"/>
            <arg value="mclachlan.brewday.ui.swing.screens.RecipesScreenTest"/>
            <arg value="mclachlan.brewday.ui.swing.screens.RecipesScreenEditNavTest"/>
            <arg value="mclachlan.brewday.ui.swing.screens.ProcessTemplatesScreenTest"/>
            <arg value="mclachlan.brewday.ui.swing.dialogs.RecipeEditorDialogTest"/>
            <arg value="mclachlan.brewday.ui.swing.widgets.SwingRecipeTreeTest"/>
            <arg value="mclachlan.brewday.ui.swing.widgets.SwingComputedVolumePaneTest"/>
            <arg value="mclachlan.brewday.ui.swing.widgets.SwingProcessStepPaneTest"/>
            <arg value="mclachlan.brewday.ui.swing.widgets.SwingHeatPaneTest"/>
            <arg value="mclachlan.brewday.ui.swing.widgets.SwingMashPaneTest"/>
