    <!--======================================================================-->
    <target name="build" depends="compile"/>

    <!--======================================================================-->
    <!-- Verify toolchain for jdeps/jlink/jpackage -->
    <!--======================================================================-->
    <target name="package-deps-properties">
        <available property="_have.jdeps" file="${jdk.jdeps.cmd}" type="file"/>
        <fail message="${jdk.package.home}: missing bin/jdeps. Use a full JDK (21+). Set JDK_PACKAGE_HOME or JAVA_HOME to that JDK if Ant runs on a JRE-only or patched distro JDK."
              unless="_have.jdeps"/>
        <available property="_have.jlink" file="${jdk.jlink.cmd}" type="file"/>
        <fail message="${jdk.package.home}: missing bin/jlink."
              unless="_have.jlink"/>
        <available property="_have.jpackage" file="${jdk.jpackage.cmd}" type="file"/>
        <fail message="${jdk.package.home}: missing bin/jpackage."
              unless="_have.jpackage"/>
        <!-- Distro packages (e.g. Fedora java-*-openjdk) patch conf/security/java.security; jlink aborts. -->
        <condition property="_jdk.rpm.openjdk.style.path">
            <matches string="${jdk.package.home}" pattern=".*java-[0-9]+-openjdk.*"/>
        </condition>
        <fail message="Packaging JDK appears to be a distro OpenJDK (${jdk.package.home}). jlink rejects patched conf/security/java.security. Use an unmodified JDK 21+: set JDK_PACKAGE_HOME for one-off builds; copy packaging-jdk.local.xml.example to packaging-jdk.local.xml and set jdk.package.home; unpack Temurin under build/.packaging-jdk/current; or set JAVA_HOME to that JDK. See doc/packaging.md (Fedora / RPM OpenJDK note)."
              if="_jdk.rpm.openjdk.style.path"/>
    </target>

    <!--======================================================================-->
    <!-- Boot JAR manifest Class-Path must be rebuilt inside macrodef locals: invoking
         e.g. "ant package-stage package-jdeps-scan" runs package-stage twice (Ant runs
         each CLI target chain separately), which would otherwise leave pkg.manifest.cp set. -->
    <!--======================================================================-->
    <macrodef name="jar-brewday-with-lib-manifest">
        <sequential>
            <local name="pkg.manifest.cp"/>
            <manifestclasspath property="pkg.manifest.cp" jarfile="${package.stage}${file.separator}brewday.jar">
                <classpath>
                    <fileset dir="${package.stage}/lib" includes="**/*.jar"/>
                </classpath>
            </manifestclasspath>
            <jar jarfile="${package.stage}/brewday.jar" basedir="${build}">
                <manifest>
                    <attribute name="Main-Class" value="mclachlan.brewday.ui.swing.app.SwingApp"/>
                    <attribute name="Class-Path" value="${pkg.manifest.cp}"/>
                </manifest>
            </jar>
        </sequential>
    </macrodef>

    <!--======================================================================-->
    <!-- Stage Swing distribution: jars + brewday.cfg + embedded runtime classpath manifest -->
    <!--======================================================================-->
    <target name="package-stage" depends="compile">
        <mkdir dir="${package.stage}/lib"/>
        <mkdir dir="${package.prod.db.work}"/>
        <!-- Writable prod-db workspace under ./build (avoids mutating repo-root data/db during packaging) -->
        <copy todir="${package.prod.db.work}" overwrite="true">
            <fileset dir="data/db" includes="**/*"/>
        </copy>

        <!-- seed db JSON into package.prod.db.work -->
        <java classname="mclachlan.brewday.util.CreateProdDb" fork="true"
              classpathref="project.class.path">
            <sysproperty key="brewday.prod.db.dir" value="${package.prod.db.work}"/>
        </java>

        <copy todir="${package.stage}/lib">
            <fileset dir="lib">
                <include name="**/*.jar"/>
                <exclude name="test/**"/>
                <exclude name="javafx/**"/>
                <exclude name="jfxtras/**"/>
                <exclude name="miglayout-javafx/**"/>
            </fileset>
        </copy>

        <copy file="src/dist/dist.brewday.cfg" tofile="${package.stage}/brewday.cfg"/>
        <copy file="release_notes.txt" tofile="${package.stage}/release_notes.txt"/>
        <copy file="README.md" tofile="${package.stage}/README.md"/>
        <copy file="${package.license.file}" tofile="${package.stage}/LICENSE.TXT"/>

        <copy todir="${package.stage}/data">
            <fileset dir="data">
                <exclude name="db/**"/>
            </fileset>
        </copy>
        <copy todir="${package.stage}/data/db">
            <fileset dir="${package.prod.db.work}" includes="**/*"/>
        </copy>

        <jar-brewday-with-lib-manifest/>
    </target>

    <!--======================================================================-->
    <target name="package-jdeps-scan" depends="package-deps-properties, package-stage">
        <mkdir dir="${package.base}"/>
        <path id="package.jdeps.cp">
            <pathelement location="${build}"/>
            <fileset dir="${package.stage}/lib" includes="**/*.jar"/>
        </path>
        <pathconvert property="package.jdeps.cp.prop" pathsep="${path.separator}" refid="package.jdeps.cp"/>
        <exec executable="${jdk.jdeps.cmd}" failonerror="true" output="${package.base}/jdeps-line.raw.txt">
            <arg value="--multi-release"/>
            <arg value="${java.release}"/>
            <arg value="--ignore-missing-deps"/>
            <arg value="--recursive"/>
            <arg value="--print-module-deps"/>
            <arg value="--class-path"/>
            <arg value="${package.jdeps.cp.prop}"/>
            <arg value="${build}"/>
        </exec>
        <loadfile srcFile="${package.base}/jdeps-line.raw.txt" property="package.jmods.auto">
            <filterchain>
                <striplinebreaks/>
            </filterchain>
        </loadfile>
        <condition property="_jlink.manual.chunk" value=",${package.jlink.manual.modules}" else="">
            <matches string="${package.jlink.manual.modules}" pattern=".+"/>
        </condition>
        <property name="package.jlink.add.modules" value="${package.jmods.auto}${_jlink.manual.chunk}"/>
        <echo file="${package.base}/jdeps-modules.merge.txt">${package.jlink.add.modules}${line.separator}</echo>
        <condition property="_jdeps.modules.empty">
            <not>
                <matches pattern=".+" string="${package.jmods.auto}"/>
            </not>
        </condition>
        <fail message="jdeps produced empty module line; inspect ${package.base}/jdeps-line.raw.txt" if="_jdeps.modules.empty"/>
    </target>

    <!--======================================================================-->
    <!-- WARNING: regenerated per host OS — run jlink/package on Linux and Windows separately for release -->
    <!--======================================================================-->
    <target name="package-jlink-runtime" depends="package-jdeps-scan">
        <delete dir="${package.runtime.image}" quiet="true"/>
        <exec executable="${jdk.jlink.cmd}" failonerror="true">
            <arg value="--module-path"/>
            <arg value="${jdk.modules.dir}"/>
            <arg value="--add-modules"/>
            <arg value="${package.jlink.add.modules}"/>
            <arg value="--strip-debug"/>
            <arg value="--no-man-pages"/>
            <arg value="--no-header-files"/>
            <arg value="--output"/>
            <arg value="${package.runtime.image}"/>
        </exec>
    </target>

    <!--======================================================================-->
    <target name="package-linux-app-image" depends="package-jlink-runtime">
        <condition property="_is.windows"><os family="windows"/></condition>
        <fail message="package-linux-app-image must run on macOS/Linux (not Windows)." if="_is.windows"/>
        <available property="_have.linux.package.icon" file="${package.icon.linux}" type="file"/>
        <fail message="Missing Linux app-image icon at ${package.icon.linux}. Add data/img/brewday.png."
              unless="_have.linux.package.icon"/>
        <delete dir="${package.jpackage.out.linux}" quiet="true"/>
        <mkdir dir="${package.jpackage.out.linux}"/>
        <exec executable="${jdk.jpackage.cmd}" failonerror="true">
            <arg value="--type"/>
            <arg value="app-image"/>
            <arg value="--name"/>
            <arg value="Brewday"/>
            <arg value="--app-version"/>
            <arg value="${mclachlan.brewday.version}"/>
            <arg value="--vendor"/>
            <arg value="Brewday"/>
            <arg value="--icon"/>
            <arg value="${package.icon.linux}"/>
            <arg value="--runtime-image"/>
            <arg value="${package.runtime.image}"/>
            <arg value="--dest"/>
            <arg value="${package.jpackage.out.linux}"/>
            <arg value="--input"/>
            <arg value="${package.stage}"/>
            <arg value="--main-jar"/>
            <arg value="brewday.jar"/>
            <arg value="--java-options"/>
            <arg value="--add-opens=java.desktop/sun.swing=ALL-UNNAMED"/>
            <arg value="--java-options"/>
            <arg value="--add-opens=java.desktop/javax.swing=ALL-UNNAMED"/>
            <arg value="--java-options"/>
            <arg value="--add-opens=java.desktop/javax.swing.text=ALL-UNNAMED"/>
            <arg value="--java-options"/>
            <arg value="-splash:$$APPDIR/data/img/brewday_splash.bmp"/>
        </exec>

        <copy file="${package.license.file}" todir="${package.jpackage.out.linux}/Brewday"/>

        <tar destfile="${dist}/brewday-${mclachlan.brewday.version}-linux-x64.tar.gz" compression="gzip" longfile="gnu">
            <tarfileset dir="${package.jpackage.out.linux}" filemode="755" prefix=""/>
        </tar>

    </target>

    <!-- exe requires WiX 3.x; installer-style Windows deliverable -->
    <!--======================================================================-->
    <target name="package-windows-exe" depends="package-jlink-runtime">
        <condition property="_not.windows"><not><os family="windows"/></not></condition>
        <fail message="package-windows-exe must run on Windows with WiX (Light) on PATH." if="_not.windows"/>
        <delete dir="${package.jpackage.out.windows}" quiet="true"/>
        <mkdir dir="${package.jpackage.out.windows}"/>
        <exec executable="${jdk.jpackage.cmd}" failonerror="true">
            <arg value="--type"/>
            <arg value="exe"/>
            <arg value="--name"/>
            <arg value="Brewday"/>
            <arg value="--app-version"/>
            <arg value="${mclachlan.brewday.version}"/>
            <arg value="--vendor"/>
            <arg value="Brewday"/>
            <arg value="--runtime-image"/>
            <arg value="${package.runtime.image}"/>
            <arg value="--dest"/>
            <arg value="${package.jpackage.out.windows}"/>
            <arg value="--input"/>
            <arg value="${package.stage}"/>
            <arg value="--main-jar"/>
            <arg value="brewday.jar"/>
            <arg value="--win-menu"/>
            <arg value="--win-shortcut"/>
            <arg value="--java-options"/>
            <arg value="--add-opens=java.desktop/sun.swing=ALL-UNNAMED"/>
            <arg value="--java-options"/>
            <arg value="--add-opens=java.desktop/javax.swing=ALL-UNNAMED"/>
            <arg value="--java-options"/>
            <arg value="--add-opens=java.desktop/javax.swing.text=ALL-UNNAMED"/>
            <arg value="--java-options"/>
            <arg value="-splash:$$APPDIR/data/img/brewday_splash.bmp"/>
        </exec>
    </target>

    <!--======================================================================-->
    <target name="package-complete">
        <echo>Next: ant package-linux-app-image (Linux/macOS) or ant package-windows-exe (Windows + WiX). Requires prior package-jlink-runtime chain.</echo>
    </target>

    <!--======================================================================-->
    <!-- Portable zip of staged Swing tree (still needs a JDK on PATH to run java -jar) -->
    <!--======================================================================-->
    <target name="zipdist" depends="package-stage">
        <mkdir dir="${dist}"/>
        <zip destfile="${dist}/brewday_${mclachlan.brewday.version}_staging.zip" level="9">
            <fileset dir="${package.stage}"/>
        </zip>
    </target>

    <!--======================================================================-->
    <!-- Full packaging: staging zip (classpath) + Linux/macOS jpackage app-image (embedded runtime). Omit package-windows-exe from this chain; run it on Windows + WiX when needed. -->
    <target name="dist" depends="zipdist, package-linux-app-image"/>

</project>
